# Firebase Configuration Keys
# Copy this file to .env and fill in your Firebase project configuration
VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789

# Google Gemini & Embedding 2 API Key
# Get your free key at: https://aistudio.google.com/app/apikey
# WARNING: any VITE_* variable is bundled into the public JS. Restrict this key by
# HTTP referrer / API in Google Cloud Console (or proxy it through a server function).
VITE_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Teacher panel login (client-side gate only, NOT real security; use Firebase Auth for that)
# Generate the hash of your password:  printf 'your-password' | shasum -a 256 | cut -d' ' -f1
VITE_TEACHER_USERNAME=teacher
VITE_TEACHER_PASSWORD_HASH=sha256-hex-of-your-password
